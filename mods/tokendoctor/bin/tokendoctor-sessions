#!/usr/bin/env node
// Read-only measure of where tokens went, from local session transcripts.
// Usage: tokendoctor-sessions [--days <n>] [--project <dir>] [--by day|week] [--json]
import { configDir } from '../lib/collect.mjs'
import { trend } from '../lib/history.mjs'
import { loadSessions, localDay, summarize } from '../lib/sessions.mjs'

const args = process.argv.slice(2)
const value = (name) => (args.includes(name) ? args[args.indexOf(name) + 1] : undefined)

const days = Number(value('--days') ?? 30)
const by = value('--by')

if (by) {
  printTrend(by === 'week' ? weekly(trend(configDir(), days)) : trend(configDir(), days))
  process.exit(0)
}

// Monday of the row's week, in local time.
function weekly(rows) {
  const out = {}
  for (const r of rows) {
    const d = new Date(`${r.date}T12:00:00`)
    d.setDate(d.getDate() - ((d.getDay() + 6) % 7))
    const x = (out[localDay(d)] ??= { date: localDay(d), unit: 'usd', cost: 0, mainCost: 0, bigContextCost: 0, turns: 0, sessions: 0, byModel: {} })
    if (r.unit !== 'usd') x.unit = null
    for (const k of ['cost', 'mainCost', 'bigContextCost', 'turns', 'sessions']) x[k] += r[k]
    for (const [m, c] of Object.entries(r.byModel)) x.byModel[m] = (x.byModel[m] ?? 0) + c
  }
  return Object.values(out)
}

function printTrend(rows) {
  if (args.includes('--json')) return console.log(JSON.stringify(rows, null, 2))
  if (!rows.length) return console.log(`过去 ${days} 天没有数据。`)
  const p = (x, of) => `${Math.round((100 * x) / (of || 1))}%`.padStart(5)
  console.log(`${by === 'week' ? '该周      ' : '日期      '}      费用($)  子代理  >400K  opus  轮次  会话数`)
  for (const r of rows) {
    const top = (r.byModel.opus ?? 0) + (r.byModel.fable ?? 0)
    console.log(
      `${r.date}  ${(r.unit === 'usd' ? r.cost.toFixed(2) : '–').padStart(11)}  ${p(r.cost - r.mainCost, r.cost).padStart(9)}  ${p(r.bigContextCost, r.mainCost)}  ${p(top, r.cost)}  ${String(r.turns).padStart(5)}  ${String(r.sessions).padStart(8)}`,
    )
  }
}
const sessions = loadSessions(configDir(), { days, project: value('--project') })
const { totals: t, findings, usage } = summarize(sessions)
const pct = (x, of = t.cost) => `${Math.round((100 * x) / (of || 1))}%`
const byCost = (o, f = (v) => v) => Object.entries(o).sort((a, b) => f(b[1]) - f(a[1]))

if (args.includes('--json')) {
  const top = [...sessions].sort((a, b) => b.cost - a.cost).slice(0, 10)
    .map(({ project, start, turns, cost, mainCost, maxContext }) => ({ project, start, turns, cost, subagentCost: cost - mainCost, maxContext }))
  const { compactions, ...rest } = t
  console.log(JSON.stringify({ days, totals: { ...rest, compactions: compactions.length }, topSessions: top, findings, usage }, null, 2))
} else if (!sessions.length) {
  console.log(`过去 ${days} 天没有会话。`)
} else {
  console.log(`过去 ${days} 天有 ${t.sessions} 个会话，按 API 标价为 $${t.cost.toFixed(2)}（套餐下：同样工作在 API 上的费用）。`)
  if (t.hiddenCost) console.log(`其中 $${t.hiddenCost.toFixed(2)} 是记录里看不到的请求（总结压缩、标题、WebFetch 页面读取）：有 Claude Code 自己的会话总计时用总计，否则为估算值。`)
  if (t.unpriced) console.log(`${t.unpriced} 条来自没有已知价格的模型的回复未计入。`)
  console.log(`主线程 ${pct(t.mainCost)}，子代理 ${pct(t.cost - t.mainCost)}；上下文超过 400K 时主线程占 ${pct(t.bigContextCost, t.mainCost)}。`)
  console.log(`主线程按模型：${byCost(t.byModel).map(([m, c]) => `${m} ${pct(c)}`).join('、')}`)
  console.log(`子代理：${byCost(t.agents, (a) => a.cost).slice(0, 5).map(([k, a]) => `${k} 运行 ${a.runs} 次 ${pct(a.cost)}`).join('；') || '无'}`)
  console.log(`缓存重建：${byCost(t.rebuilds, (e) => e.cost).map(([k, e]) => `${k} ${e.n}`).join('；') || '无'}；压缩 ${t.compactions.length} 次`)
  console.log(`思考占输出 token 的 ${pct(t.thinking, t.output)}\n`)
  for (const f of findings) console.log(`[${f.severity}] ${f.id}：${f.title}\n  ${f.detail}\n  ${f.doc}\n`)
  if (!findings.length) console.log('没有问题。')
}
